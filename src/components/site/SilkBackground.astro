---
// Silk: a slow, folded color field (warm white, beige, sand, light brown) that drifts on its own and
// bends toward the pointer. Inspired by pionect.com's hero; our own WebGL2 shader, no library.
// Decorative only (aria-hidden). Renders at reduced resolution (the CSS scales it up, which softens it),
// pauses in hidden tabs, draws one still frame under reduced motion, and leaves the fallback
// (`slot`, e.g. a photo) visible when WebGL2 isn't available. Paper grain comes from the site's
// global grain layer plus a stronger local one here.
interface Props { class?: string; fixed?: boolean }
const { class: cls, fixed = false } = Astro.props;
---
<div class:list={['silk pointer-events-none overflow-hidden', fixed ? 'fixed inset-0 -z-10' : 'absolute inset-0', cls]} aria-hidden="true">
	<div class="silk-fallback absolute inset-0"><slot /></div>
	<canvas class="silk-canvas absolute inset-0 h-full w-full opacity-0 transition-opacity duration-1000"></canvas>
	<div class="silk-grain absolute inset-0"></div>
</div>

<style>
	.silk { background: #EFE6DA; }
	.silk-grain { background-image: var(--grain); background-size: 200px; opacity: .5; mix-blend-mode: soft-light; }
	.silk.live .silk-canvas { opacity: 1; }
	.silk.live .silk-fallback { opacity: 0; transition: opacity 1s; }
</style>

<script>
	const VERT = `#version 300 es
in vec2 a; void main() { gl_Position = vec4(a, 0., 1.); }`;

	const FRAG = `#version 300 es
precision highp float;
uniform vec2 uRes; uniform float uTime; uniform vec2 uMouse; uniform float uStir;
out vec4 o;

float hash(vec2 p) { return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }
float noise(vec2 p) {
	vec2 i = floor(p), f = fract(p);
	vec2 u = f * f * (3. - 2. * f);
	return mix(mix(hash(i), hash(i + vec2(1, 0)), u.x), mix(hash(i + vec2(0, 1)), hash(i + vec2(1, 1)), u.x), u.y);
}
float fbm(vec2 p) {
	float v = 0., a = .5;
	mat2 r = mat2(.8, .6, -.6, .8);
	for (int i = 0; i < 3; i++) { v += a * noise(p); p = r * p * 2.03 + 1.7; a *= .5; }
	return v / .875;
}

void main() {
	float aspect = uRes.x / uRes.y;
	vec2 uv = gl_FragCoord.xy / uRes;
	vec2 p = (uv - .5) * vec2(aspect, 1.);
	vec2 m = (uMouse - .5) * vec2(aspect, 1.);
	float t = uTime * .035;

	// the pointer draws the cloth toward itself and twists it a little while it moves
	vec2 dm = p - m;
	float pull = exp(-dot(dm, dm) * 1.6);
	float ang = (.45 + uStir * 1.6) * pull;
	p = m + mat2(cos(ang), -sin(ang), sin(ang), cos(ang)) * dm * (1. - .22 * pull);

	// broad, slow warp: big soft folds rather than ripples
	vec2 q = vec2(fbm(p * .65 + vec2(0., t)), fbm(p * .65 + vec2(5.2, 1.3) - t));
	float band = p.x * .85 - p.y * 1.25 + 1.9 * q.x + .9 * q.y;
	float ridge = sin(band * 2.1 + uTime * .09) * .5 + .5;
	float shadow = pow(1. - ridge, 2.6);
	float sheen = pow(max(0., 1. - abs(ridge - .86) * 4.2), 2.);
	float calm = smoothstep(.5, .78, fbm(p * .32 + vec2(t * .6, -t * .4) + 7.)); // open, quiet stretches

	vec3 warmWhite = vec3(.965, .945, .89);   // #F6F1E3
	vec3 beige     = vec3(.886, .835, .776);  // #E2D5C6
	vec3 sand      = vec3(.788, .718, .612);  // #C9B79C
	vec3 brown     = vec3(.659, .529, .42);   // #A8876B
	vec3 clay      = vec3(.784, .412, .247);  // #C8693F

	vec3 col = mix(beige, warmWhite, smoothstep(.1, .9, ridge));
	col = mix(col, sand, shadow * .7);
	col = mix(col, brown, pow(1. - ridge, 7.) * .5);
	col += vec3(1., .99, .965) * sheen * .14;
	col = mix(col, warmWhite, calm * .55);
	col = mix(col, clay, pull * .06 * ridge); // a warm hint under the pointer
	col *= 1. - .08 * pow(length(uv - vec2(.5, .45)), 2.);

	o = vec4(col, 1.);
}`;

	function init(root: HTMLElement) {
		const canvas = root.querySelector('canvas')!;
		const gl = canvas.getContext('webgl2', { antialias: false, alpha: false, powerPreference: 'low-power' });
		if (!gl) return; // fallback stays visible

		const sh = (type: number, src: string) => {
			const s = gl.createShader(type)!; gl.shaderSource(s, src); gl.compileShader(s);
			if (!gl.getShaderParameter(s, gl.COMPILE_STATUS)) throw new Error(gl.getShaderInfoLog(s) || 'shader');
			return s;
		};
		const prog = gl.createProgram()!;
		gl.attachShader(prog, sh(gl.VERTEX_SHADER, VERT));
		gl.attachShader(prog, sh(gl.FRAGMENT_SHADER, FRAG));
		gl.linkProgram(prog);
		if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) return;
		gl.useProgram(prog);

		const buf = gl.createBuffer();
		gl.bindBuffer(gl.ARRAY_BUFFER, buf);
		gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
		const loc = gl.getAttribLocation(prog, 'a');
		gl.enableVertexAttribArray(loc);
		gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);

		const uRes = gl.getUniformLocation(prog, 'uRes');
		const uTime = gl.getUniformLocation(prog, 'uTime');
		const uMouse = gl.getUniformLocation(prog, 'uMouse');
		const uStir = gl.getUniformLocation(prog, 'uStir');

		const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
		const SCALE = 0.42; // render at ~40% resolution: smooth, soft, and cheap
		const resize = () => {
			const w = Math.max(1, Math.round(root.clientWidth * SCALE));
			const h = Math.max(1, Math.round(root.clientHeight * SCALE));
			if (canvas.width !== w || canvas.height !== h) { canvas.width = w; canvas.height = h; gl.viewport(0, 0, w, h); }
			gl.uniform2f(uRes, w, h);
		};

		// pointer: eased toward the target; movement speed stirs the twist, which settles back
		const target = { x: .62, y: .42 }, cur = { x: .62, y: .42 };
		let stir = 0, lastX = 0, lastY = 0;
		if (!still) {
			addEventListener('pointermove', (e) => {
				if (e.pointerType === 'touch') return;
				const r = root.getBoundingClientRect();
				target.x = (e.clientX - r.left) / r.width;
				target.y = 1 - (e.clientY - r.top) / r.height;
				stir = Math.min(1, stir + Math.hypot(e.clientX - lastX, e.clientY - lastY) / 900);
				lastX = e.clientX; lastY = e.clientY;
			}, { passive: true });
		}

		let raf = 0, t0 = performance.now(), visible = true;
		const draw = (now: number) => {
			resize();
			cur.x += (target.x - cur.x) * .04; cur.y += (target.y - cur.y) * .04;
			stir *= .965;
			gl.uniform1f(uTime, still ? 18 : (now - t0) / 1000 + 18);
			gl.uniform2f(uMouse, cur.x, cur.y);
			gl.uniform1f(uStir, stir);
			gl.drawArrays(gl.TRIANGLES, 0, 3);
		};
		const loop = (now: number) => { draw(now); raf = visible && !document.hidden ? requestAnimationFrame(loop) : 0; };
		const start = () => { if (!raf && !still) raf = requestAnimationFrame(loop); };

		draw(performance.now());
		root.classList.add('live');
		if (still) { addEventListener('resize', () => draw(performance.now())); return; }
		start();
		document.addEventListener('visibilitychange', start);
		new IntersectionObserver(([e]) => { visible = e.isIntersecting; start(); }).observe(root);
	}

	document.querySelectorAll<HTMLElement>('.silk').forEach((el) => { try { init(el); } catch { /* fallback stays */ } });
</script>
