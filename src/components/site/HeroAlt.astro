---
// Hero for /alt/, from Figma "MB UX Assets" › "Mediabarn alt" (node 2023:12997, frame 1304 × 735).
// Layers, back to front: the photo (fallback under the live silk), the dark wireframe waves,
// the nav, the centered headline and line, and the client card strip along the bottom.
// The strip runs wider than the screen in the design, so it scrolls as a slow marquee
// (paused on hover or focus; a plain sideways scroller under reduced motion).
import SilkBackground from './SilkBackground.astro';
import { clientCards } from '@/data/clientCards';
import { pillars, products } from '@/data/site';

const A = '/images/hero-alt';
// Nav order as designed: Design, Research, Product
const navOrder = ['design', 'research', 'product'].map((id) => pillars.find((p) => p.id === id)!);
---
<section class="hero-alt relative isolate overflow-hidden" aria-labelledby="hero-alt-h">
	<SilkBackground>
		{/* Figma "image 5": mirrored, warm overlay. Shown when the silk can't run. */}
		<div class="hero-photo absolute">
			<img src={`${A}/hero-photo.png`} alt="" class="absolute inset-0 h-full w-full object-cover object-bottom" />
			<div class="absolute inset-0 bg-[rgba(241,214,188,0.76)] mix-blend-overlay"></div>
		</div>
	</SilkBackground>

	{/* Figma "Abstract Element Dark": the brand waves, rotated, bleeding off the right */}
	<div class="hero-waves pointer-events-none absolute flex items-center justify-center" aria-hidden="true">
		<div class="hero-waves-inner flex-none"><img src={`${A}/waves-dark.svg`} alt="" class="block h-full w-full" /></div>
	</div>

	<div class="relative mx-auto max-w-[1304px]">
		{/* nav */}
		<header class="flex items-start justify-between px-[clamp(16px,3.2vw,42px)] pt-[30px]">
			<a href="/" class="hero-logo relative block" aria-label="Mediabarn home">
				<img src={`${A}/logo-barn.svg`} alt="" class="absolute" style="inset:0.49% 0.09% 2.39% 71.14%" />
				<img src={`${A}/logo-text.svg`} alt="" class="absolute" style="inset:50.76% 12.28% 0.96% 0.44%" />
			</a>
			<nav aria-label="Main" class="flex items-center gap-[clamp(20px,4vw,54px)] pr-[clamp(0px,1vw,37px)] pt-[0px]">
				<ul role="list" class="hidden items-center gap-[54px] tab:flex">
					{navOrder.map((p) => <li><a href={p.href} class="hero-link">{p.name}</a></li>)}
				</ul>
				<button type="button" class="menu-btn grid size-10 place-items-center -m-3" aria-expanded="false" aria-controls="alt-menu">
					<img src={`${A}/menu.svg`} alt="" width="12" height="8" />
					<span class="sr-only">Menu</span>
				</button>
			</nav>
		</header>

		{/* headline + line */}
		<div class="px-[var(--gut)] pt-[clamp(48px,6.2vw,79px)] text-center">
			<h1 id="hero-alt-h" class="hero-h mx-auto max-w-[1000px]">Creating Experiences the Human&#8209;Centered Way.</h1>
			<p class="hero-sub mx-auto mt-[19px] max-w-[552px]">We specialize in HCD to deliver the best digital experiences for your <strong>customers.</strong></p>
		</div>
	</div>

	{/* client strip */}
	<div class="strip relative mt-[clamp(48px,6.2vw,80px)]" tabindex="0" aria-label="Clients we’ve worked with" role="region">
		<ul role="list" class="strip-track flex w-max">
			{[0, 1].map((copy) => clientCards.map((c) => (
				<li class:list={['card relative shrink-0', c.shadow && 'card-shadow']} aria-hidden={copy === 1 ? 'true' : undefined}>
					<img src={c.photo} alt="" class="absolute inset-0 h-full w-full object-cover" loading="lazy" />
					<div class="absolute inset-0" style={`background:${c.tint}`}></div>
					{c.logo && (
						<div class="absolute overflow-clip" style={`inset:${c.logo.inset}`}>
							{c.logo.inner
								? <div class="absolute" style={`inset:${c.logo.inner}`}><img src={c.logo.src} alt={copy === 0 ? c.name : ''} class="absolute inset-0 block h-full w-full" /></div>
								: <img src={c.logo.src} alt={copy === 0 ? c.name : ''} class="absolute inset-0 block h-full w-full" />}
						</div>
					)}
					{c.pieces && (
						<div class="absolute left-1/2 -translate-x-1/2 overflow-clip" style={`top:${c.pieces.top};bottom:${c.pieces.bottom};aspect-ratio:${c.pieces.aspect}`} role={copy === 0 ? 'img' : undefined} aria-label={copy === 0 ? c.name : undefined}>
							{c.pieces.items.map((it) => <img src={it.src} alt="" class="absolute block" style={`inset:${it.inset}`} />)}
						</div>
					)}
				</li>
			)))}
		</ul>
	</div>
</section>

{/* menu panel (hamburger) */}
<div id="alt-menu" class="alt-menu fixed inset-0 z-50" hidden>
	<div class="alt-menu-scrim absolute inset-0" data-close></div>
	<nav aria-label="Menu" class="alt-menu-panel absolute inset-y-0 right-0 flex w-[min(420px,100%)] flex-col gap-10 overflow-y-auto p-8 pt-7">
		<div class="flex items-center justify-between">
			<span class="eyebrow">Menu</span>
			<button type="button" class="grid size-10 place-items-center -m-2 text-[22px] leading-none" data-close aria-label="Close menu">×</button>
		</div>
		<ul role="list" class="grid gap-3">
			{pillars.map((p, i) => <li><a href={p.href} class="flex items-baseline gap-4 font-serif text-[40px] leading-tight hover:text-[var(--red-ink)]"><span class="font-mono text-[12px] text-[var(--red-ink)]">0{i + 1}</span>{p.name}</a></li>)}
		</ul>
		<div>
			<p class="eyebrow mb-3">Products</p>
			<ul role="list" class="grid gap-2 text-[16px]">{products.map((p) => <li><a href={p.href} class="hover:text-[var(--red-ink)]">{p.name}</a></li>)}</ul>
		</div>
		<ul role="list" class="mt-auto grid gap-2 text-[16px] font-semibold">
			<li><a href="/about/" class="hover:text-[var(--red-ink)]">About</a></li>
			<li><a href="/contact/" class="btn mt-2">Contact us <span class="arrow" aria-hidden="true">→</span></a></li>
		</ul>
	</nav>
</div>

<style is:global>
	/* global (prefixed): Astro doesn't scope elements produced by the nested map below */
	.hero-alt { --brown: #483933; color: var(--brown); }
	.hero-alt .hero-photo { left: -1.92%; top: -25.48%; width: 103.84%; height: 145.39%; transform: scaleX(-1); }

	/* Figma: inset -72.94% -43.62% -116.47% -13.69%, element rotated 52.43° and sized against its box */
	.hero-alt .hero-waves { inset: -72.94% -43.62% -116.47% -13.69%; container-type: size; }
	.hero-alt .hero-waves-inner { width: hypot(50.4594cqw, 63.2428cqh); height: hypot(-49.5406cqw, 36.7572cqh); rotate: 52.43deg; }

	.hero-alt .hero-logo { width: 161px; height: 50px; }
	.hero-alt .hero-link { font-weight: 600; font-size: 14px; line-height: 1.204; letter-spacing: -0.05em; color: var(--brown); }
	.hero-alt .hero-link:hover { color: var(--red-ink); }

	.hero-alt .hero-h { font-family: Didot, 'Bodoni Moda Variable', 'Bodoni 72', serif; font-weight: 700; font-size: clamp(44px, 7.06vw, 92px); line-height: .95; letter-spacing: -0.05em; color: rgba(237, 1, 9, .7); text-wrap: balance; }
	.hero-alt .hero-sub { font-weight: 300; font-size: clamp(18px, 1.85vw, 24px); line-height: 1.204; letter-spacing: -0.05em; color: var(--brown); text-wrap: balance; }
	.hero-alt .hero-sub strong { font-weight: 600; }

	.hero-alt .card { width: var(--card-size, clamp(150px, 18.8vw, 245px)); aspect-ratio: 1; background: #d9d9d9; }
	.hero-alt .card-shadow { filter: drop-shadow(0 4px 6.6px rgba(71, 32, 32, .25)); }
	.hero-alt .strip { overflow: hidden; }
	.hero-alt .strip:focus-visible { outline-offset: -3px; }
	@media (prefers-reduced-motion: no-preference) {
		.hero-alt .strip-track { animation: mb-strip 60s linear infinite; }
		.hero-alt .strip:hover .strip-track, .hero-alt .strip:focus-within .strip-track { animation-play-state: paused; }
	}
	@keyframes mb-strip { to { transform: translateX(-50%); } }
	@media (prefers-reduced-motion: reduce) {
		.hero-alt .strip { overflow-x: auto; }
		.hero-alt .strip-track > [aria-hidden='true'] { display: none; }
	}

	.alt-menu-scrim { background: color-mix(in srgb, var(--espresso) 35%, transparent); backdrop-filter: blur(6px); }
	.alt-menu-panel { background: var(--paper-light); color: var(--ink); box-shadow: -20px 0 60px -30px rgba(30, 18, 14, .5); }
	html.motion .alt-menu:not([hidden]) .alt-menu-panel { animation: mb-panel-in .45s var(--ease); }
	@keyframes mb-panel-in { from { transform: translateX(40px); opacity: 0; } }
</style>

<script is:inline>
	(() => {
		const menu = document.getElementById('alt-menu');
		const btn = document.querySelector('.menu-btn');
		if (!menu || !btn) return;
		const open = (on) => {
			menu.hidden = !on;
			btn.setAttribute('aria-expanded', String(on));
			document.documentElement.style.overflow = on ? 'hidden' : '';
			(on ? menu.querySelector('a') : btn)?.focus();
		};
		btn.addEventListener('click', () => open(menu.hidden));
		menu.querySelectorAll('[data-close]').forEach((el) => el.addEventListener('click', () => open(false)));
		addEventListener('keydown', (e) => { if (e.key === 'Escape' && !menu.hidden) open(false); });
	})();
</script>
