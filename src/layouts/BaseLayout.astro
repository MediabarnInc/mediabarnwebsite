---
import '@/styles/global.css';
import ReviewToggle from '@/components/site/ReviewToggle.astro';
import AltNav from '@/components/site/AltNav.astro';
import AltMenu from '@/components/site/AltMenu.astro';
import Footer from '@/components/site/Footer.astro';
import NextLens from '@/components/site/NextLens.astro';
import SquareCursor from '@/components/site/SquareCursor.astro';
import type { PillarId } from '@/data/site';

interface Props {
	title: string;
	description?: string;
	/** which pillar this page belongs to: lights it in the nav and adds the loop band at the end */
	pillar?: PillarId;
	/** 'bar' (default): the sticky nav bar. 'hero': the page's hero has the nav built in (home), so the
	 *  bar only slides in once the visitor scrolls past it. */
	nav?: 'bar' | 'hero';
}
const { title, description = 'Mediabarn brings research, design, and product together, using Human-Centered Design.', pillar, nav = 'bar' } = Astro.props;
// search results show about 155 characters: trim longer descriptions at a word, with an ellipsis
const desc = description.length > 158 ? description.slice(0, 155).replace(/\s+\S*$/, '').replace(/[,;:]$/, '') + '…' : description;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="preload" href="/fonts/theano-didot.woff2" as="font" type="font/woff2" crossorigin />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title} | Mediabarn</title>
		<meta name="description" content={desc} />
		{/* share card: title and description for links pasted into Slack, LinkedIn, texts */}
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Mediabarn" />
		<meta property="og:title" content={`${title} | Mediabarn`} />
		<meta property="og:description" content={desc} />
		{/* share image: the home hero (1200 × 630). Absolute URL from `site` in astro.config.mjs, so set that
		    to the live domain or previews will look for the image there */}
		<meta property="og:image" content={new URL('/og-image.jpg', Astro.site ?? Astro.url).href} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Mediabarn: Creating Experiences the Human-Centered Way." />
		<meta property="og:url" content={new URL(Astro.url.pathname, Astro.site ?? Astro.url).href} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:image" content={new URL('/og-image.jpg', Astro.site ?? Astro.url).href} />
		<meta name="theme-color" content="#EAE4D7" />
		<meta name="robots" content="noindex" />{/* pre-launch */}
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		{/* Motion gate: hidden/resting states only exist under html.motion, so without JS,
		    without IntersectionObserver, or with reduced motion, everything renders in place. */}
		<script is:inline>
			(() => {
				addEventListener('load', () => setTimeout(() => document.documentElement.classList.add('loaded'), 100));
				if (matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) return;
				const r = document.documentElement;
				r.classList.add('motion');
				addEventListener('DOMContentLoaded', () => {
					try {
						const io = new IntersectionObserver((es) => { for (const e of es) if (e.isIntersecting) { e.target.classList.add('up'); io.unobserve(e.target); } }, { threshold: 0.08 });
						document.querySelectorAll('[data-reveal],[data-stagger],[data-unveil]').forEach((el) => io.observe(el));
					} catch { r.classList.remove('motion'); }
				});
			})();
		</script>
	</head>
	<body>
		<a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-3 focus:top-3 focus:z-[70] focus:bg-[var(--red-deep)] focus:px-3 focus:py-2 focus:text-white">Skip to content</a>
		<AltNav variant="bar" pillar={pillar} reveal={nav === 'hero'} />
		<main id="main">
			<slot />
			{pillar && <NextLens current={pillar} light={pillar === 'research'} />}
		</main>
		<Footer />
		<AltMenu />
		<ReviewToggle />
		<SquareCursor />
		{/* Open every page at the top. A link to a page (no #section) always starts at the top, even inside
		    a preview frame whose host page would otherwise keep its scroll; back, forward, and reload still restore the
		    position, and #links still land on their section. */}
		<script is:inline>
			(() => {
				try {
					const nav = performance.getEntriesByType('navigation')[0];
					if (location.hash || (nav && (nav.type === 'back_forward' || nav.type === 'reload'))) return;
					const top = () => {
						window.scrollTo(0, 0);
						// also brings an embedding frame's host page back to this page's top
						document.body.scrollIntoView({ block: 'start', behavior: 'instant' });
					};
					top();
					addEventListener('load', top, { once: true });
				} catch {}
			})();
		</script>
	</body>
</html>
