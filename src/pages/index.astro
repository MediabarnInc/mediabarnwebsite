---
// Home (mb-alt, 2026-10-28): the Figma "Mediabarn alt" hero with a live silk background, then a
// lighter, centered, image-led layout. The loop home lives on in mb2.0.
import BaseLayout from '@/layouts/BaseLayout.astro';
import HeroAlt from '@/components/site/HeroAlt.astro';
import Placeholder from '@/components/site/Placeholder.astro';
import Note from '@/components/site/Note.astro';
import Cta from '@/components/site/Cta.astro';
import { pillars, products } from '@/data/site';
import { photos } from '@/data/images';

const stats = [
	{ n: '20+', l: 'years in Human-Centered Design' },
	{ n: '[0,000]', l: 'research participants recruited' },
	{ n: '[000]', l: 'usability studies hosted' },
	{ n: '4', l: 'products built and supported' },
];
const sectors = [
	{ t: 'Federal', h: '/federal/', d: 'Forms, portals, and services that citizens and taxpayers can actually finish, with Section 508 compliance built in.', tint: 'rgba(30,65,170,.38)', mood: 'dusk' as const, photo: photos.peopleWriting },
	{ t: 'Healthcare', h: '/healthcare/', d: 'Patient, practitioner, and payer journeys mapped, measured, and improved, one initiative at a time.', tint: 'rgba(129,117,112,.38)', mood: 'clay' as const, photo: photos.telehealthNurse },
];
// one photo per pillar, from the supplied photography
const pillarPhotos = [photos.researchInterview, photos.designWorkshop, photos.laptopAndPhone];

---

<BaseLayout title="Creating experiences the human-centered way" nav="none" description="Mediabarn uses Human-Centered Design to deliver the best digital experiences for customers, citizens, patients, and employees.">
	<HeroAlt />

	{/* ---------- Three ways in ---------- */}
	<section class="alt-sec bg-[var(--paper-light)]" aria-labelledby="ways-h">
		<div class="wrap">
			<h2 id="ways-h" class="mx-auto max-w-[22ch] text-center">Research tells us what people need. Design shapes it. Products keep it <span class="em">working</span>.</h2>
			<ol role="list" class="mt-16 grid gap-6 desk:grid-cols-3">
				{pillars.map((p, i) => (
					<li>
						<a href={p.href} class="group flex h-full flex-col border border-[var(--line)] bg-[var(--paper)] transition-[border-color,transform] duration-300 hover:-translate-y-1 hover:border-[var(--red)]">
							<Placeholder label={`${p.name}: photography`} ratio="4/3" src={pillarPhotos[i]} />
							<div class="flex grow flex-col gap-3 p-7">
								<span class="eyebrow">0{i + 1} / {p.verb}</span>
								<h3 class="font-serif !text-[34px] !font-normal leading-none">{p.name}</h3>
								<p class="body grow">{p.oneLiner}</p>
								<span class="link self-start">Explore {p.name.toLowerCase()} <span class="arrow" aria-hidden="true">→</span></span>
							</div>
						</a>
					</li>
				))}
			</ol>
		</div>
	</section>

	{/* ---------- Where we work: photo cards in the hero strip's style ---------- */}
	<section class="alt-sec" aria-labelledby="where-h">
		<div class="wrap">
			<div class="mb-14 grid gap-6 desk:grid-cols-[1fr_1fr] desk:items-end">
				<h2 id="where-h" class="max-w-[14ch]">Where experience is <span class="em">hardest</span> to get right.</h2>
				<p class="lede max-w-[46ch] desk:justify-self-end">Most of our work is in government services and healthcare, where getting the experience wrong costs people time, money, and care.</p>
			</div>
			<div class="grid gap-6 tab:grid-cols-2">
				{sectors.map((s) => (
					<a href={s.h} class="group relative block overflow-hidden">
						<Placeholder label={`${s.t}: photography`} ratio="5/4" src={s.photo} class="transition-transform duration-700 group-hover:scale-[1.03]" />
						<div class="absolute inset-0" style={`background:${s.tint}`}></div>
						<div class="absolute inset-x-0 bottom-0 grid gap-3 p-8 text-[var(--paper-light)]">
							<h3 class="font-serif !text-[clamp(40px,4.4vw,60px)] !font-normal leading-none !text-[var(--paper-light)]">{s.t} <span class="arrow text-[.6em]" aria-hidden="true">→</span></h3>
							<p class="max-w-[40ch] text-[16px] leading-[1.6] text-[color-mix(in_srgb,var(--paper-light)_88%,transparent)]">{s.d}</p>
						</div>
					</a>
				))}
			</div>
		</div>
	</section>

	{/* ---------- Products ---------- */}
	<section class="alt-sec bg-[#E2D5C6]" aria-labelledby="prod-h">
		<div class="wrap">
			<h2 id="prod-h" class="mx-auto max-w-[20ch] text-center">Software that came out of the <span class="em">work</span>.</h2>
			<p class="lede mx-auto mt-5 max-w-[52ch] text-center !text-[#483933]">We kept seeing the same problems across clients, so we built tools for them.</p>
			<ul role="list" class="mt-16 grid gap-4 tab:grid-cols-2 desk:grid-cols-4">
				{products.map((p) => (
					<li>
						<a href={p.href} class="group flex h-full flex-col gap-3 bg-[var(--paper-light)] p-7 transition-transform duration-300 hover:-translate-y-1">
							<span class="eyebrow">For {p.for.toLowerCase()}</span>
							<span class="font-serif text-[32px] leading-none group-hover:text-[var(--red-ink)]">{p.name}</span>
							<span class="body grow text-[15px]">{p.summary}</span>
							<span class="arrow self-start text-[var(--red-ink)]" aria-hidden="true">→</span>
						</a>
					</li>
				))}
			</ul>
		</div>
	</section>

	{/* ---------- Track record ---------- */}
	<section class="alt-sec bg-[var(--paper-light)]" aria-labelledby="track-h">
		<div class="wrap">
			<h2 id="track-h" class="sr-only">Track record</h2>
			<dl class="grid grid-cols-2 gap-y-12 text-center desk:grid-cols-4">
				{stats.map((s) => (
					<div class="flex flex-col-reverse justify-end gap-2">
						<dt class="body mx-auto max-w-[18ch]">{s.l}</dt>
						<dd class="font-serif text-[clamp(48px,5vw,72px)] leading-none ">{s.n}</dd>
					</div>
				))}
			</dl>
			<Note class="mt-6">Bracketed numbers are placeholders until we have the real figures.</Note>
			<figure class="mx-auto mt-24 max-w-[900px] text-center">
				<blockquote class="font-serif text-[clamp(26px,3vw,40px)] leading-[1.22]">“I can honestly say you all have been the 100% best of all the markets in this study. Absolutely no issues, so professional, great respondents, cool facility, & fun to work with on top of all that.”</blockquote>
				<figcaption class="eyebrow mt-8">Lead Researcher, national research study</figcaption>
			</figure>
		</div>
	</section>

	<Cta />
</BaseLayout>

<style>
	.alt-sec { padding-block: clamp(72px, 9vw, 140px); color: #483933; }
	.alt-sec h2 { color: #483933; }
</style>
