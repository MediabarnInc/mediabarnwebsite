---
// All case studies (2026-11-11): the menu's "All case studies" lands here — the same gallery grid as the
// Design page's work section, with every study shown.
import BaseLayout from '@/layouts/BaseLayout.astro';
import CaseStudies from '@/components/site/CaseStudies.astro';
import Cta from '@/components/site/Cta.astro';
import { cases } from '@/data/cases';
---

<BaseLayout title="Our work" pillar="design" description="Case studies: who we worked with, what we did, and what changed for the people on the other side.">
	<CaseStudies limit={cases.length} featured={false} />
	<Cta />
</BaseLayout>
