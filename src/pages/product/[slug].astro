---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/site/Section.astro';
import SectionHeader from '@/components/site/SectionHeader.astro';
import Note from '@/components/site/Note.astro';
import Placeholder from '@/components/site/Placeholder.astro';
import Cta from '@/components/site/Cta.astro';
import SilkBackground from '@/components/site/SilkBackground.astro';
import { products } from '@/data/site';
import { details } from '@/data/productDetails';

export function getStaticPaths() {
	return products.map((p) => ({ params: { slug: p.slug } }));
}
const { slug } = Astro.params;
const p = products.find((x) => x.slug === slug)!;
const d = details[slug!];
const others = products.filter((x) => x.slug !== slug);
const anyConfirm = d.features.some((f) => f.confirm);
---
<BaseLayout title={p.name} pillar="product" description={d.lede}>
	{/* the home hero’s background: the textured silk glow (without the wave lines) */}
	<section class="page-hero relative isolate overflow-hidden py-[clamp(48px,6vw,96px)]">
		<SilkBackground texture="/images/hero-alt/hero-texture.webp" />
		<div class="wrap">
			<nav aria-label="Breadcrumb" class="crumbs mb-4"><a href="/product/">Product</a> / <span aria-current="page">{p.name}</span></nav>
			<div class="grid gap-10 desk:grid-cols-[1fr_1fr] desk:items-center">
				<div>
					<h1 class="product-h mb-6 max-w-[17ch]">{d.headlineBefore}<span class="em">{d.headlineEm}</span>{d.headlineAfter}</h1>
					<p class="lede max-w-[52ch]">{d.lede}</p>
					<div class="mt-8 flex flex-wrap gap-3">
						<a href={`/contact/?topic=${p.slug}`} class="btn max-pad:w-full">{d.cta}</a>
						{d.site
							? <a href={d.site.url} class="btn btn-outline max-pad:w-full" target="_blank" rel="noopener">Visit {d.site.label} <span class="arrow" aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a>
							: <a href="#features" class="btn btn-outline max-pad:w-full">See features</a>}
					</div>
					{d.usedBy && <p class="body mt-6 text-[14.5px]"><span class="font-semibold">Used by</span> {d.usedBy.join(', ')}, and other federal agencies.</p>}
				</div>
				<div class="border border-[var(--line-strong)] p-2">
					<div class="mb-2 flex gap-1.5" aria-hidden="true"><span class="size-2.5 rounded-full bg-[var(--line-strong)]"></span><span class="size-2.5 rounded-full bg-[var(--line-strong)]"></span><span class="size-2.5 rounded-full bg-[var(--line-strong)]"></span></div>
					{d.shot
						? <Placeholder label={`${p.name}: product screenshot`} ratio={`${d.shot.image.width}/${d.shot.image.height}`} src={d.shot.image} alt={d.shot.alt} sizes="(min-width: 1021px) 560px, 100vw" />
						: <Placeholder label={`${p.name}: product screenshot`} ratio="16/10" />}
					{d.shot?.caption && <p class="body mt-2 px-1 text-[13px]">{d.shot.caption}</p>}
				</div>
			</div>
		</div>
	</section>

	<Section tone="light" glow="mist" fibers={false}>
		<div class="grid gap-8 desk:grid-cols-[1fr_1fr] desk:gap-16">
			<div><h2 class="max-w-[20ch]">{d.problemTitle}</h2></div>
			<div class="grid gap-4">{d.problem.map((x) => <p class="lede">{x}</p>)}</div>
		</div>
	</Section>

	<Section id="features" glow="paper" fibers={false}>
		<SectionHeader before="What " em={p.name} after=" does." />
		<div class="mt-12 grid gap-10 desk:grid-cols-2">
			{d.features.map((f) => (
				<div class:list={['grid gap-4', !f.image && (d.features.some((x) => x.image) ? 'glass self-start p-8' : 'pad:grid-cols-[.9fr_1.1fr] pad:items-center')]}>
					{f.image
						? <Placeholder label={`Screen: ${f.t}`} ratio={`${f.image.width}/${f.image.height}`} src={f.image} alt={f.alt} class="feature-shot" sizes="(min-width: 1021px) 560px, 100vw" />
						: !d.features.some((x) => x.image) && <Placeholder label={`Screen: ${f.t}`} ratio="4/3" />}
					<div><h3 class="mb-2">{f.t}</h3><p class="body">{f.d}</p></div>
				</div>
			))}
		</div>
		{anyConfirm && <Note class="mt-8">These features are inferred from the one-line description. Please have the product owner confirm or replace them.</Note>}
	</Section>

	<Section glow="sand" fibers={false}>
		<SectionHeader before="Built for the people who " em="use" after=" it." />
		<div class="mt-12 grid gap-6 desk:grid-cols-3">
			{d.audience.map((a) => <div class="border border-[var(--line)] bg-[var(--paper-light)] p-7 shadow-[0_18px_40px_-28px_rgba(72,57,51,.5)]"><h3 class="mb-3">{a.t}</h3><p class="body">{a.d}</p></div>)}
		</div>
	</Section>

	<Section glow="paper" class="glow-flip" fibers={false}>
		<div class="grid gap-8 desk:grid-cols-2 desk:gap-16">
			<div>
				
				<h2 class="mb-4 max-w-[20ch]">Designed with the people who <span class="em">use</span> it.</h2>
				<p class="body max-w-[52ch]">{p.name} was built by the same team that runs our research lab and design studio. We test it with real users, and what we learn goes into the next release.</p>
			</div>
			{d.pricing ? (
				<div class="border border-[var(--line-strong)] p-8"><p class="eyebrow mb-2">Pricing</p><p class="h3 mb-4">{d.pricing}</p><div class="flex flex-wrap gap-3"><a href={`/contact/?topic=${p.slug}`} class="btn max-pad:w-full">{d.cta}</a>{d.site && <a href={d.site.url} class="btn btn-outline max-pad:w-full" target="_blank" rel="noopener">See plans <span class="arrow" aria-hidden="true">↗</span><span class="sr-only"> on {d.site.label} (opens in a new tab)</span></a>}</div></div>
			) : (
				<div class="grid gap-4 self-start  pad:grid-cols-3">
					{[['Tested', 'with real users in our lab'], ['Supported', 'by the team that built it'], ['Improved', 'from what users tell us']].map(([t, s]) => <div class="glass p-5"><p class="h4">{t}</p><p class="body text-[14.5px]">{s}</p></div>)}
				</div>
			)}
		</div>
		{d.note && <Note class="mt-8">{d.note}</Note>}
	</Section>

	<Section tone="light" glow="mist" class="glow-flip" fibers={false}>
		<p class="eyebrow mb-6">More from Mediabarn Product</p>
		<ul role="list" class="grid gap-4 desk:grid-cols-3">
			{others.map((o) => <li><a href={o.href} class="flex h-full flex-col gap-2 glass p-6 hover:border-[var(--red)]"><span class="h3">{o.name} →</span><span class="eyebrow">{o.for}</span><span class="body text-[15px]">{o.summary}</span></a></li>)}
		</ul>
	</Section>

	<Cta heading="See " em={p.name} after=" in action." body={`Tell us a little about your organization and we’ll walk you through ${p.name}.`} />
</BaseLayout>

<style>
	/* a smaller headline than other page heroes, so the screenshot sits beside it on desktop */
	.page-hero h1.product-h { font-size: clamp(40px, 4.6vw, 68px); }
	/* the hero copy and screenshot sit above the silk */
	.page-hero > .wrap { position: relative; }
</style>
