---
import BaseLayout from '@/layouts/BaseLayout.astro';
import BgImage from '@/components/site/BgImage.astro';
import CaseStudies from '@/components/site/CaseStudies.astro';
import Section from '@/components/site/Section.astro';
import SectionHeader from '@/components/site/SectionHeader.astro';
import Note from '@/components/site/Note.astro';
import Placeholder from '@/components/site/Placeholder.astro';
import Cta from '@/components/site/Cta.astro';
import VennDiagram from '@/components/site/VennDiagram.astro';
import { photos } from '@/data/images';

const terms = [
	{ t: 'Customer Experience (CX)', d: 'CX is the entirety of a customer’s journey with a product, company, or brand. Seeing a message on a billboard, making an online purchase, and calling a help desk are all examples of a customer experience.' },
	{ t: 'User Experience (UX)', d: 'UX is the digital channel of CX, since interactions with digital products and services are often a large part of the customer experience. Because so many of the products we work on are mainly digital, much of our work is UX research and design.' },
	{ t: 'Service Design (SD)', d: 'Service Design unifies the entire system. It connects the front-end touchpoints customers interact with to the behind-the-scenes people, processes, and content that deliver the service.' },
];
const capabilities = [
	{ t: 'Planning & Strategy', items: ['Product strategy', 'CX and UX strategy', 'Agile ceremonies', 'Content strategy', 'Design thinking and elaboration', 'Project management'] },
	{ t: 'Research', items: ['Persona development', 'Usability testing', 'Card sorts and tree tests', 'Participant recruitment', 'Ethnography', 'Heuristic evaluations'], link: { href: '/research/', label: 'Full research services' } },
	{ t: 'Design', items: ['Journey maps and service blueprints', 'Information architecture', 'UI and interaction design', 'Interactive prototypes (Figma, HTML/CSS)', 'Design systems and governance', 'Accessibility and Section 508 compliance'] },
];
const why = [
	{ t: 'HCD specialization', d: 'We are specialists, not generalists. Our team applies focused expertise across strategy, customer research, experience design, and service design, so each part of the work is done by someone who does it every day.' },
	{ t: 'Our own research labs', d: 'We were one of the first CX consultancies to build in-house research lab facilities. With full lab operations and a dedicated recruiting team, we involve real users throughout the design process, not just at the end.' },
	{ t: 'We recommend what fits', d: 'We build a few products of our own, and they came out of client work. But when we design for you, we recommend the tools and platforms that fit your needs, including ones we don’t make. The experience comes first.' },
];
---

<BaseLayout title="Experience Design" pillar="design" description="Human-Centered Design for service design, customer experience, and user experience.">
	<section class="page-hero noisy relative overflow-hidden py-[clamp(72px,10vw,150px)]">
		<BgImage label="a team sketching a journey together" src={photos.designWorkshop} scrim="light" mood="sand" focus="85% 45%" side />
		<div class="wrap">
			<div>
				<h1 class="mb-6 max-w-[16ch]">Designing experiences the <span class="em">human-centered</span> way.</h1>
				<p class="lede max-w-[54ch]">We use Human-Centered Design (HCD) to understand what people need, collect their feedback, and use it to improve services and products. Whether the people are customers, citizens, patients, or employees, every design we make is informed by research.</p>
				<div class="mt-8 flex flex-wrap gap-3"><a href="#work" class="btn max-pad:w-full">See our work <span class="arrow" aria-hidden="true">↓</span></a><a href="/contact/?topic=design" class="btn btn-outline max-pad:w-full">Talk to the design team</a></div>
			</div>
		</div>
	</section>

	<CaseStudies />

	<Section tone="light" id="think">
		{/* one grid, three places: phone: heading, diagram, definitions; tablet: the diagram beside the
		    heading; desktop: heading across the top, the diagram beside the definitions */}
		<div class="think-grid">
			<SectionHeader class="think-head" before="CX, UX, and Service Design are " em="not" after=" the same thing.">These terms are often used interchangeably. We provide all three, and we think it’s worth explaining the difference.</SectionHeader>
			<div class="think-venn"><VennDiagram /></div>
			<dl class="think-defs grid gap-8">
				{terms.map((x, i) => <div class="border-t border-[var(--line)] pt-5" data-term={['cx', 'ux', 'sd'][i]}><dt class="h3 mb-2">{x.t}</dt><dd class="body">{x.d}</dd></div>)}
			</dl>
		</div>
	</Section>

	<Section id="what" tone="dark">
		<SectionHeader before="Strategy, research, and " em="design" after=", under one roof.">A full range of capabilities, from the first stakeholder interview to a tested, accessible design.</SectionHeader>
		{/* the dark board: a muted red shape (square, rounded, circle) sits behind each group name (2026-11-11) */}
		<div class="mt-[clamp(56px,6vw,88px)] grid gap-12 desk:grid-cols-3 desk:gap-16">
			{capabilities.map((c, i) => (
				<div>
					<div class="relative flex min-h-[clamp(76px,7.2vw,96px)] items-center">
						<span aria-hidden="true" class="pointer-events-none absolute top-0 left-0 size-[clamp(76px,7.2vw,96px)] bg-[color-mix(in_srgb,var(--red)_32%,var(--espresso))] select-none"></span>
						<h3 class="relative pl-[clamp(16px,1.8vw,24px)] font-[family-name:var(--font-sans)]! text-[clamp(16px,1.6vw,20px)]! font-medium! uppercase! leading-tight! tracking-[0.08em]!">{c.t}</h3>
					</div>
					<div class="mt-8 mb-7 border-t border-[color-mix(in_srgb,var(--paper)_35%,transparent)]"></div>
					<ul role="list" class="grid gap-3 body">{c.items.map((x) => <li>{x}</li>)}</ul>
					{c.link && <a href={c.link.href} class="link mt-6 inline-block text-[14.5px] font-semibold">{c.link.label} →</a>}
				</div>
			))}
		</div>
		<p class="body mt-12 max-w-[60ch]">This is a partial list. If you don’t see what you’re looking for, ask us. Chances are it’s in our wheelhouse.</p>
	</Section>

	<Section tone="light" id="why" bg={{ label: "a designer at work", src: photos.cafeLaptop, focus: "50% 60%", mood: "sand" }}>
		<SectionHeader before="Specialists, by " em="design" after="." />
		<div class="mt-12 grid gap-4 desk:grid-cols-3">
			{why.map((w) => <div class="glass p-7"><h3 class="mb-3">{w.t}</h3><p class="body">{w.d}</p></div>)}
		</div>
		<Note class="mt-6">Changed on purpose: the current site’s third reason, “Technology Independent,” says Mediabarn has no bias because it doesn’t sell a software product. With a Product pillar, that’s no longer true, so it’s rewritten as “We recommend what fits.” Please review.</Note>
	</Section>

	<Section id="industries">
		<SectionHeader before="Two sectors where experience is " em="hardest" after=" to get right." />
		<div class="mt-12 grid gap-6 desk:grid-cols-2">
			{[
				{ t: 'Federal', h: '/federal/', d: 'Human-Centered Design for agencies and the people they serve: CX, user research, service design, and UX governance. Available through GSA MAS and the NIST Human Factors and Usability BPA.' , img: photos.capitolSunset, alt: 'The U.S. Capitol at sunset' },
				{ t: 'Healthcare', h: '/healthcare/', d: 'Enterprise CX for patients, practitioners, and payers, with research run under strict protocols and HIPAA compliance.' , img: photos.careConversation, alt: 'A patient talking with a provider' },
			].map((x) => (
				<a href={x.h} class="glass group block overflow-hidden">
					<Placeholder label={`${x.t} photo`} ratio="16/9" class="!border-0 !border-b" src={x.img} alt={x.alt} />
					<div class="p-6"><h3 class="mb-2">{x.t} <span aria-hidden="true" class="inline-block transition-transform group-hover:translate-x-1">→</span></h3><p class="body">{x.d}</p></div>
				</a>
			))}
		</div>
	</Section>

	<Cta />
</BaseLayout>

<style>
	.think-grid { display: grid; gap: 40px; grid-template-areas: "head" "venn" "defs"; }
	.think-grid > :global(.think-head) { grid-area: head; }
	.think-venn { grid-area: venn; }
	.think-defs { grid-area: defs; }
	/* tablet: the diagram fills the space to the right of the heading */
	@media (761px <= width < 1021px) {
		.think-grid { grid-template-columns: 1.15fr .85fr; grid-template-areas: "head venn" "defs defs"; column-gap: 32px; align-items: center; }
		/* the heading spans the same width as the intro beneath it */
		.think-grid > :global(.think-head) :global(h2) { max-width: none; text-wrap: pretty; }
	}
	/* desktop: heading across the top, the diagram beside the definitions */
	@media (width >= 1021px) {
		.think-grid { grid-template-columns: .8fr 1.2fr; grid-template-areas: "head head" "venn defs"; column-gap: 40px; row-gap: 48px; align-items: center; }
	}
</style>
