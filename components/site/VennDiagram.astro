---
// CX / UX / SD Venn for the Design page, drawn after the current site's diagram (2026-11-02): CX the
// largest, SD overlapping it from the upper left, UX inside CX across the SD edge. Inter labels. Hovering or focusing a circle lights its definition, and hovering a definition
// lights its circle (pair them with data-term="cx|ux|sd" on the definitions). The highlight is a pointer
// nicety: the diagram is one labelled image for screen readers, and the definitions beside it carry the content.
---
<figure class="venn" data-venn>
	{/* geometry from mediabarninc.com's "How we think" diagram: SD overlaps CX from the top left, and UX sits
	    inside CX where it overlaps SD (circle sizes 341 / 275 / 155 there) */}
	<svg viewBox="-4 -4 450 393" role="img" aria-label="A Venn diagram: Customer Experience (CX) is the largest circle. Service Design (SD) overlaps it from the upper left. User Experience (UX) sits inside CX, where it overlaps Service Design.">
		<g class="venn-c" data-term="cx"><circle cx="271.5" cy="214.5" r="170.5" /></g>
		<g class="venn-c" data-term="sd"><circle cx="137.5" cy="137.5" r="137.5" /></g>
		<g class="venn-c" data-term="ux"><circle cx="195.5" cy="235.5" r="77.5" /></g>
		<g class="venn-labels" aria-hidden="true">
			<text x="370" y="225">CX</text>
			<text x="54" y="149">SD</text>
			<text x="173" y="226">UX</text>
		</g>
	</svg>
</figure>

<style>
	/* fills its column on desktop (about 380px) and sits centred above the definitions below desk */
	.venn { margin: 0 auto; width: min(100%, 380px); }
	.venn svg { display: block; width: 100%; height: auto; overflow: visible; }
	/* as on the current site: soft beige discs with a fine tan outline, stacked so overlaps read darker */
	.venn-c circle { fill: #F4EEE6; fill-opacity: .6; stroke: #C9A68A; stroke-width: 1.5; transition: fill .3s var(--ease), fill-opacity .3s var(--ease), stroke .3s var(--ease); cursor: pointer; }
	.venn.has-active .venn-c circle { fill-opacity: .35; }
	.venn.has-active .venn-c.active circle { fill: #E8B8A0; fill-opacity: .75; stroke: var(--red); }
	.venn-labels text { font-family: 'Inter Variable', Inter, system-ui, sans-serif; font-weight: 700; font-size: 34px; text-anchor: middle; fill: #1E1512; pointer-events: none; }
	/* the definition paired with the lit circle */
	:global([data-term].venn-lit) { border-color: var(--red) !important; }
	:global([data-term].venn-lit dt) { color: var(--red-ink); }
	:global(dl [data-term]) { transition: border-color .3s var(--ease); }
	:global(dl [data-term] dt) { transition: color .3s var(--ease); }
</style>

<script is:inline>
	(() => {
		document.querySelectorAll('[data-venn]').forEach((fig) => {
			const scope = fig.closest('section') || document;
			// looked up when used: the definitions come after this script in the page
			const defsOf = () => [...scope.querySelectorAll('dl [data-term]')];
			const set = (term) => {
				fig.classList.toggle('has-active', !!term);
				fig.querySelectorAll('.venn-c').forEach((c) => c.classList.toggle('active', c.dataset.term === term));
				defsOf().forEach((d) => d.classList.toggle('venn-lit', d.dataset.term === term));
			};
			fig.querySelectorAll('.venn-c').forEach((c) => {
				c.addEventListener('pointerenter', () => set(c.dataset.term));
				c.addEventListener('click', () => { set(c.dataset.term); defsOf().find((d) => d.dataset.term === c.dataset.term)?.scrollIntoView({ block: 'nearest', behavior: 'smooth' }); });
			});
			fig.addEventListener('pointerleave', () => set(null));
			addEventListener('DOMContentLoaded', () => defsOf().forEach((d) => { d.addEventListener('pointerenter', () => set(d.dataset.term)); d.addEventListener('pointerleave', () => set(null)); }));
		});
	})();
</script>
