---
// Interactive wave lines (after wave-lines.learnframer.site): the 47 lines of the Figma
// "Abstract Element Dark", drawn on a canvas. At rest they sit exactly where the design puts them;
// a moving pointer drags the nearby lines along with it, and each point eases back to its resting
// place with almost no wobble. Untouched, the lines still drift slowly (a soft, wide wave through
// the whole drawing), so the hero never sits completely still; the drift pauses off-screen and in hidden tabs.
// Sits above the silk glow and below the hero copy. Decorative (aria-hidden).
// Without JS, or under reduced motion, a still image of the same artwork shows instead; it is only
// downloaded in those cases (the noscript copy, or the script setting its src), never alongside the canvas.
// The idle drift redraws at most 30 times a second (15 on low-power devices) and only where a mouse can
// reach the lines; on touch screens they're drawn once. The pointer's pull runs at the full frame rate.
interface Props { fallback: string }
const { fallback } = Astro.props;
---
<div class="wave-lines pointer-events-none absolute inset-0" aria-hidden="true">
	<img data-src={fallback} alt="" class="wave-lines-fallback absolute inset-0 h-full w-full object-cover" />
	<noscript><img src={fallback} alt="" class="absolute inset-0 h-full w-full object-cover" /></noscript>
	<canvas class="wave-lines-canvas absolute inset-0 h-full w-full"></canvas>
</div>

<style>
	.wave-lines-canvas { opacity: 0; }
	.wave-lines.live .wave-lines-canvas { opacity: 1; }
	.wave-lines.live .wave-lines-fallback { opacity: 0; }
</style>

<script>
	import { waveLines, waveStyles, WAVE_FRAME, WAVE_COLOR, WAVE_GROUP_OPACITY } from '@/data/waveLines';

	// Tuning (frame pixels; the frame is 1304 x 735 and is scaled to cover the hero)
	const RADIUS = 150;     // how far from the pointer lines are affected
	const DRAG = 0.3;       // how much of the pointer's movement a point picks up
	const SPRING = 0.04;    // pull back toward the resting shape
	const DAMPING = 0.78;   // velocity kept each frame (lower settles faster; at 0.78 the lines ease back with almost no wobble)
	const MAX_OFFSET = 36;  // a point never strays further than this
	const DRIFT = 9;        // idle drift: how far points wander (frame px)
	const DRIFT_SPEED = 0.42; // idle drift: how fast (lower is calmer)

	function decode(s: string) {
		const v = s.split(',').map(Number);
		let x = v[0], y = v[1];
		const pts = [x / 2, y / 2];
		for (let i = 2; i < v.length; i += 2) { x += v[i]; y += v[i + 1]; pts.push(x / 2, y / 2); }
		return new Float32Array(pts);
	}

	function init(root: HTMLElement) {
		const hero = root.closest('section') as HTMLElement;
		const canvas = root.querySelector('canvas')!;
		const ctx = canvas.getContext('2d');
		if (!ctx) return;

		// rest positions, offsets and velocities, one flat array per line
		const rest = waveLines.map(decode);
		const off = rest.map((r) => new Float32Array(r.length));
		const vel = rest.map((r) => new Float32Array(r.length));

		// frame → screen mapping (cover, centered), recomputed on resize
		let scale = 1, ox = 0, oy = 0, dpr = 1, W = 0, H = 0;
		const resize = () => {
			dpr = Math.min(devicePixelRatio || 1, 2);
			W = root.clientWidth; H = root.clientHeight;
			canvas.width = Math.round(W * dpr); canvas.height = Math.round(H * dpr);
			scale = Math.max(W / WAVE_FRAME.w, H / WAVE_FRAME.h);
			ox = (W - WAVE_FRAME.w * scale) / 2; oy = (H - WAVE_FRAME.h * scale) / 2;
		};

		const draw = () => {
			ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
			ctx.clearRect(0, 0, W, H);
			ctx.setTransform(dpr * scale, 0, 0, dpr * scale, dpr * ox, dpr * oy);
			ctx.lineCap = 'round';
			// many tiny segments: bevel joins look the same at this size and cost far less than round ones
			ctx.lineJoin = 'bevel';
			// while the lines only drift, every other point is plenty (the curves are gentle); full detail
			// while the pointer is pulling them
			const stride = moving ? 2 : 4;
			for (let l = 0; l < rest.length; l++) {
				const r = rest[l], o = off[l], s = waveStyles[l], ph = l * 0.23;
				ctx.strokeStyle = `rgba(${WAVE_COLOR}, ${(s.a * WAVE_GROUP_OPACITY).toFixed(3)})`;
				ctx.lineWidth = s.w;
				ctx.setLineDash(s.dash ?? []);
				ctx.beginPath();
				for (let i = 0; i < r.length; i = i + stride < r.length || i === r.length - 2 ? i + stride : r.length - 2) {
					// idle drift: two slow waves, varying across the drawing and between lines
					const rx = r[i], ry = r[i + 1];
					const x = rx + o[i] + DRIFT * Math.sin(t * 0.7 + ry * 0.011 + ph);
					const y = ry + o[i + 1] + DRIFT * Math.sin(t + rx * 0.008 - ph);
					if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
				}
				ctx.stroke();
			}
		};

		const step = () => {
			let energy = 0;
			for (let l = 0; l < rest.length; l++) {
				const o = off[l], v = vel[l];
				for (let i = 0; i < o.length; i++) {
					v[i] = (v[i] - o[i] * SPRING) * DAMPING;
					o[i] += v[i];
					if (o[i] > MAX_OFFSET) o[i] = MAX_OFFSET; else if (o[i] < -MAX_OFFSET) o[i] = -MAX_OFFSET;
					energy += Math.abs(v[i]) + Math.abs(o[i]) * 0.05;
				}
			}
			return energy;
		};

		// pointer: convert to frame space and push nearby points along with the movement
		let px = NaN, py = NaN;
		const push = (fx: number, fy: number, dx: number, dy: number) => {
			const R2 = RADIUS * RADIUS;
			for (let l = 0; l < rest.length; l++) {
				const r = rest[l], o = off[l], v = vel[l];
				for (let i = 0; i < r.length; i += 2) {
					const ex = r[i] + o[i] - fx, ey = r[i + 1] + o[i + 1] - fy;
					const d2 = ex * ex + ey * ey;
					if (d2 > R2) continue;
					const f = 1 - Math.sqrt(d2) / RADIUS;
					const k = f * f * DRAG;
					v[i] += dx * k; v[i + 1] += dy * k;
				}
			}
		};

		let raf = 0, inView = true, moving = false, t = 0, last = 0;
		const lowPower = (navigator.hardwareConcurrency || 8) <= 4 || ((navigator as any).deviceMemory || 8) <= 4;
		const IDLE_FRAME = 1000 / (lowPower ? 15 : 30);
		// phones and tablets can't move the lines (no hover), so there the lines are drawn once and stay still:
		// the drift is the costliest part of the hero, and it's the slow devices that would pay for it
		const canHover = matchMedia('(hover: hover) and (pointer: fine)').matches;
		const loop = (now: number) => {
			// drifting alone is slow, so it doesn't need every frame
			if (!moving && now - last < IDLE_FRAME) { raf = inView && !document.hidden ? requestAnimationFrame(loop) : 0; return; }
			last = now;
			t = (now / 1000) * DRIFT_SPEED;
			// spring physics only while the pointer has left something to settle
			if (moving && step() < 0.3) {
				for (const o of off) o.fill(0);
				for (const v of vel) v.fill(0);
				moving = false;
			}
			draw();
			raf = inView && !document.hidden ? requestAnimationFrame(loop) : 0;
		};
		const kick = () => { if (!raf && inView && !document.hidden && (canHover || moving)) raf = requestAnimationFrame(loop); };

		hero.addEventListener('pointermove', (e) => {
			if (e.pointerType === 'touch') return;
			const rect = root.getBoundingClientRect();
			const fx = (e.clientX - rect.left - ox) / scale, fy = (e.clientY - rect.top - oy) / scale;
			if (!Number.isNaN(px)) push(fx, fy, fx - px, fy - py);
			px = fx; py = fy;
			moving = true;
			kick();
		}, { passive: true });
		hero.addEventListener('pointerleave', () => { px = NaN; py = NaN; });

		resize();
		draw();
		root.classList.add('live');
		kick();
		addEventListener('resize', () => { resize(); draw(); });
		new IntersectionObserver(([e]) => { inView = e.isIntersecting; kick(); }).observe(root);
		document.addEventListener('visibilitychange', kick);
	}

	// the still image, loaded only when the canvas won't run
	const still = (el: HTMLElement) => { const img = el.querySelector<HTMLImageElement>('.wave-lines-fallback'); if (img?.dataset.src && !img.src) img.src = img.dataset.src; };
	const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
	document.querySelectorAll<HTMLElement>('.wave-lines').forEach((el) => {
		if (reduced) return still(el);
		try { init(el); if (!el.classList.contains('live')) still(el); } catch { still(el); }
	});
</script>
